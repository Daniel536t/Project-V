[TEMPLATE]
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit secrets.

# Database (Vercel Postgres or Supabase connection string)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Bright Data
BRIGHT_DATA_API_KEY=your_key_here
BRIGHT_DATA_COLLECTOR_ID=c_xxxxxxxx
# Store collector — created against the live store page (bdata scraper create).
# When set, SENSE watches carry this real collector ID and heals go through
# `bdata scraper heal` (the CLI). Unset → deterministic in-process heal.
BRIGHT_DATA_STORE_COLLECTOR_ID=c_xxxxxxxx
# Live collector — the real Hacker News collector (Phase A live watch).
# Created with: bdata scraper create https://news.ycombinator.com "Extract the top stories..."
# Scrapes run async batch (~2-3 min per job) — the real latency SENSE reports.
BRIGHT_DATA_HN_COLLECTOR_ID=c_xxxxxxxx
# SERP API zone name (create in dashboard → SERP API) — powers live search for any query
BRIGHT_DATA_SERP_ZONE=your_zone_here

# LLM APIs (NVIDIA NIM — all models)
# Two keys (separate accounts) so we fall back if one hits a rate limit.
NVIDIA_API_KEY=your_nvidia_key
NVIDIA_API_KEY_2=your_backup_nvidia_key

# OpenRouter (optional fallback for models not available on NIM)
OPENROUTER_API_KEY=your_openrouter_key
